#!/usr/bin/env python3
# 疑似 gh：GitHub の API を、ファイル（MOCK_STATE の JSON）の中だけで真似する。パイプラインのスクリプトのテスト用。
# 本物の gh が返す形のうち、スクリプトが使う物だけを実装している。知らない呼び出しは UNHANDLED で失敗させる。
import sys, json, re, subprocess, os, datetime
ST=os.environ['MOCK_STATE']
st=json.load(open(ST))
# PR の head に repo が書かれていなければ、このリポジトリの物として扱う（fork のテストだけ、明示的に別のリポジトリを書く）
for _p in st.get('pulls',[]):
    _p.setdefault('head',{}).setdefault('repo',{'full_name':os.environ.get('GITHUB_REPOSITORY','o/r')})
args=sys.argv[1:]
assert args[0]=='api'
# 呼ばれた回数を api_calls に足す（API の回数を確かめるテスト用。読むだけの呼び出しも数える）
st['api_calls']=st.get('api_calls',0)+1
def _write_state(o):
    # 一時ファイルに書いてから置き換える（読む側が、書きかけ・空のファイルを見ない）
    _t=ST+'.'+str(os.getpid())+'.tmp'
    with open(_t,'w') as _w: json.dump(o,_w)
    os.replace(_t,ST)
_write_state(st)
# 呼び出しを calls.log に1行ずつ残す（テストが失敗したとき、どう動いたかを見るため。MOCK_STATE と同じフォルダ）
try:
    with open(os.path.join(os.path.dirname(ST),'calls.log'),'a') as _f: _f.write(' '.join(args)+'\n')
except OSError:
    pass
args=args[1:]
method='GET'; q=None; fields={}; flist=[]; path=None; slurp=False; paginate=False; inbody=None
i=0
while i<len(args):
    a=args[i]
    if a=='-X': method=args[i+1]; i+=2
    elif a in('-q','--jq'): q=args[i+1]; i+=2
    elif a=='-f' or a=='-F':
        k,v=args[i+1].split('=',1)
        if k.endswith('[]'): flist.append(v)
        else: fields[k]=v
        i+=2
    elif a=='--input':
        _b=json.load(sys.stdin) if args[i+1]=='-' else json.load(open(args[i+1]))
        inbody=_b
        for _k,_v in _b.items():
            if isinstance(_v,list): flist.extend(_v)
            else: fields[_k]=_v if isinstance(_v,str) else json.dumps(_v)
        i+=2
    elif a=='--paginate': paginate=True; i+=1
    elif a=='-H': i+=2
    elif a=='--slurp': slurp=True; i+=1
    elif a.startswith('-'): i+=1
    else: path=a; i+=1
if fields or flist:
    if method=='GET': method='POST'
# fail_repos：このリポジトリへの呼び出しは全部断る（403。テンプレートに鍵が届かない、を表す）
_rm=re.match(r'^repos/([^/]+/[^/]+)',path)
_repo=_rm.group(1) if _rm else None
if _repo and _repo.lower() in [x.lower() for x in st.get('fail_repos',[])]: sys.stderr.write('HTTP 403: Resource not accessible by integration\n'); sys.exit(1)
# 状態の全体（save は全体を書く）。repos：ほかのリポジトリの状態（同じ形。{'o/r2': {'labels':…, 'issues_meta':…}}）。
# そのリポジトリへの呼び出しは、その中だけで答える（並列の上限を全部のリポジトリで数えるテスト用）
ROOT=st
_own=os.environ.get('GITHUB_REPOSITORY','o/r')
if _repo and _repo.lower()!=_own.lower() and _repo in st.get('repos',{}):
    st=st['repos'][_repo]
    for _k,_v in {'next_id':0,'comments':[],'labels':{},'issue_updated':{},'pulls':[],'checks':[],'runs':[],'jobs':[],'branches':[],'authors':{}}.items(): st.setdefault(_k,_v)
    for _p in st['pulls']: _p.setdefault('head',{}).setdefault('repo',{'full_name':_repo})
# 別のリポジトリ（GITHUB_REPOSITORY ではない所）の Issue・PR：状態だけを other_repos から返す（無ければ 404。非公開で読めない待ち先を表す）
_m=re.match(r'^repos/([^/]+/[^/]+)/issues/(\d+)$',path.split('?')[0])
if st is ROOT and _m and method=='GET' and _m.group(1).lower()!=_own.lower():
    _o=st.get('other_repos',{}).get(_m.group(1),{}).get(_m.group(2))
    if _o is None: sys.stderr.write('HTTP 404: Not Found\n'); sys.exit(1)
    if q:
        _r=subprocess.run(['jq','-r',q],input=json.dumps(_o),capture_output=True,text=True); sys.stdout.write(_r.stdout)
    else: print(json.dumps(_o))
    sys.exit(0)
path=re.sub(r'^repos/[^/]+/[^/]+/','',path)
now=st.get('now', datetime.datetime.utcnow().isoformat()+'Z')
def out(obj):
    if q:
        r=subprocess.run(['jq','-r',q],input=json.dumps(obj),capture_output=True,text=True)
        sys.stdout.write(r.stdout)
        if r.returncode: sys.stderr.write(r.stderr); sys.exit(1)
    else:
        print(json.dumps(obj))
def save(): _write_state(ROOT)
# 一覧（配列）を、本物と同じくページに分けて返す。1ページは per_page 件（既定 30）。
#   --paginate が無ければ、1ページ目だけ（101件目からは見えない）
#   --paginate と -q：ページごとに jq を当てる（本物の gh と同じ。全体の件数・並べ替えを -q だけでは出せない）
#   --paginate と --slurp：ページの配列（[[…],[…]]）
# 読んだページの数を api_pages に足す（API の回数を確かめるテスト用）
def paged(lst):
    pm=re.search(r'per_page=(\d+)',path); per=int(pm.group(1)) if pm else 30
    pages=[lst[i:i+per] for i in range(0,len(lst),per)] or [[]]
    if not paginate: pages=pages[:1]
    st['api_pages']=st.get('api_pages',0)+len(pages); save()
    if slurp: out(pages); return
    for pg in pages: out(pg)
base=path.split('?')[0]
# search API（search/issues）：題名の "…" と is:open で絞る。st['search_hidden'] の番号は出ない（作った直後で、まだ索引に無い）。
# search_fail があれば 502。本物と同じく {"items":[…]} を返す
if base=='search/issues':
    from urllib.parse import unquote
    if st.get('search_fail'): sys.stderr.write('HTTP 502\n'); sys.exit(1)
    _q=unquote(re.search(r'[?&]q=([^&]+)',path).group(1))
    # ラベルで探す（user:持ち主 is:issue is:open label:"ai:queue"）：このリポジトリと repos の全部から、開いている Issue（PRを除く）を返す。
    # search_lag の "o/r2#5" は出ない（付けたばかりで、まだ索引に無い）
    _lm=re.search(r'label:"?([^"\s]+)"?',_q)
    if _lm:
        _items=[]
        for _rn,_sub in [(_own,ROOT)]+list(ROOT.get('repos',{}).items()):
            _meta=_sub.get('issues_meta',{}); _prs={str(p.get('number')) for p in _sub.get('pulls',[])}
            for n,L in _sub.get('labels',{}).items():
                if _lm.group(1) not in L or n in _prs or _meta.get(n,{}).get('state','open')!='open': continue
                if '%s#%s'%(_rn,n) in ROOT.get('search_lag',[]): continue
                _items.append({'number':int(n),'repository_url':'https://api.github.com/repos/'+_rn,'labels':[{'name':x} for x in L],'state':'open','title':_meta.get(n,{}).get('title','t')})
        _res={'total_count':len(_items),'items':_items}
        out([_res] if slurp else _res); sys.exit(0)
    _t=re.search(r'"([^"]*)" in:title',_q).group(1)
    _meta=st.get('issues_meta',{})
    out({'items':[{'number':int(n),'title':mt.get('title',''),'state':mt.get('state','open')} for n,mt in _meta.items()
        if mt.get('title')==_t and n not in st.get('search_hidden',[]) and (' is:open' not in _q or mt.get('state','open')=='open')]}); sys.exit(0)
# GitHub App の鍵が届くリポジトリの一覧：st['installation_repos']。無ければ断る（PIPELINE_TOKEN では読めない、を表す）
if base=='installation/repositories':
    if 'installation_repos' not in st: sys.stderr.write('HTTP 403: This endpoint requires an installation token\n'); sys.exit(1)
    out({'total_count':len(st['installation_repos']),'repositories':[{'full_name':x} for x in st['installation_repos']]}); sys.exit(0)
if re.match(r'repos/[^/]+/[^/]+$',base): out({'is_template':st.get('is_template',False),'homepage':st.get('homepage')}); sys.exit(0)
# 公開（deployments）：st['deployments'] = [{'id':1,'environment':'github-pages','url':'https://…'}]
if base=='deployments':
    envm=re.search(r'environment=([^&]+)',path)
    ds=[d for d in st.get('deployments',[]) if not envm or d['environment']==envm.group(1)]
    out([{'id':d['id'],'environment':d['environment'],'statuses_url':'https://api.github.com/repos/o/r/deployments/%d/statuses'%d['id']} for d in ds]); sys.exit(0)
m=re.match(r'deployments/(\d+)/statuses$',base)
if m: out([{'state':'success','environment_url':d.get('url')} for d in st.get('deployments',[]) if str(d['id'])==m.group(1)]); sys.exit(0)
# main のコミットの一覧：st['main_commit_date']
# 1件ずつ日付を変えるときは st['commit_dates'] = {sha: 日付}。since= があれば、それより前のコミットは返さない。読んだ回数を commit_list_calls に足す
if base=='commits':
    st['commit_list_calls']=st.get('commit_list_calls',0)+1; save()
    cd=lambda x: st.get('commit_dates',{}).get(x, st.get('main_commit_date','2026-01-01T00:00:00Z'))
    sm=re.search(r'since=([^&]+)',path)
    out([{'sha':x,'commit':{'committer':{'date':cd(x)}}} for x in st.get('main_commits',['h']) if not sm or cd(x)>=sm.group(1)]); sys.exit(0)
m=re.match(r'issues/(\d+)/comments$',base)
if m:
    n=m.group(1)
    if method=='POST':
        st['next_id']+=1
        c={'id':st['next_id'],'body':fields['body'],'user':{'login':'github-actions[bot]'},'created_at':now,'updated_at':now,'issue':n}
        st['comments'].append(c); save(); out(c); sys.exit(0)
    if n in st.get('read_fail_comments',[]): sys.stderr.write('HTTP 502\n'); sys.exit(1)
    cs=[c for c in st['comments'] if c['issue']==n]
    paged(cs); sys.exit(0)
# リポジトリ全体のコメントの一覧（新しい順）。recent_comments_fail：読めない（502）
if base=='issues/comments' and method=='GET':
    if st.get('recent_comments_fail'): sys.stderr.write('HTTP 502\n'); sys.exit(1)
    out(list(reversed(st['comments']))[:100]); sys.exit(0)
m=re.match(r'issues/comments/(\d+)$',base)
if m and method=='GET':
    for c in st['comments']:
        if c['id']==int(m.group(1)): out(c); sys.exit(0)
    sys.stderr.write('HTTP 404: Not Found\n'); sys.exit(1)
if m and method=='DELETE':
    st['comments']=[c for c in st['comments'] if c['id']!=int(m.group(1))]; save(); sys.exit(0)
if m and method=='PATCH':
    for c in st['comments']:
        if c['id']==int(m.group(1)): c['body']=fields['body']; c['updated_at']=now
    save(); print('{}'); sys.exit(0)
# Issue・PR のイベント：st['events'] = {'20': [{'event':'labeled','label':{'name':'ai:hold'},'created_at':'…'}]}
m=re.match(r'issues/(\d+)/events$',base)
if m: paged(st.get('events',{}).get(m.group(1),[])); sys.exit(0)
m=re.match(r'issues/(\d+)/labels$',base)
if m:
    n=m.group(1); L=st['labels'].setdefault(n,[])
    if method=='POST':
        for l in flist:
            if l not in L: L.append(l)
        save(); print('[]'); sys.exit(0)
    # read_fail_labels：この番号のラベルは読めない（502。「ラベル無し」と取り違えないかのテスト用）
    if n in st.get('read_fail_labels',[]): sys.stderr.write('HTTP 502\n'); sys.exit(1)
    out([{'name':l} for l in L]); sys.exit(0)
m=re.match(r'issues/(\d+)/labels/(.+)$',base)
if m and method=='DELETE':
    from urllib.parse import unquote
    n=m.group(1); l=unquote(m.group(2)); L=st['labels'].setdefault(n,[])
    # label_delete_fail：この番号のラベルは外せない（502。外せたか分からないときのテスト用）
    if n in st.get('label_delete_fail',[]): sys.stderr.write('HTTP 502: Bad Gateway\n'); sys.exit(1)
    # 本物と同じく、付いていないラベルを外そうとしたら失敗（404）
    if l not in L: sys.stderr.write('HTTP 404: Label does not exist\n'); sys.exit(1)
    L.remove(l)
    save(); sys.exit(0)
m=re.match(r'issues/(\d+)$',base)
if m:
    n=m.group(1); meta=st.setdefault('issues_meta',{}).setdefault(n,{})
    if method=='PATCH':
        meta.update({k:v for k,v in fields.items() if k in('state','title','body')}); save(); print('{}'); sys.exit(0)
    # read_fail：この番号の Issue・コメントは読めない（502）。issue_extra：Issue に足す項目（author_association など）
    if n in st.get('read_fail',[]): sys.stderr.write('HTTP 502\n'); sys.exit(1)
    out({'title':meta.get('title','タイトル'+n),'state':meta.get('state','open'),'body':meta.get('body',''),'labels':[{'name':x} for x in st['labels'].get(n,[])],'user':{'login':st.get('authors',{}).get(n,'o')},'updated_at':st['issue_updated'].get(n,now),**st.get('issue_extra',{}).get(n,{})}); sys.exit(0)
if base=='issues' and method=='POST':
    meta=st.setdefault('issues_meta',{})
    num=str(max([int(k) for k in list(st['labels'])+list(meta)]+[100])+1)
    meta[num]={'title':fields.get('title',''),'state':'open','body':fields.get('body',''),'repo':_repo}
    st['labels'][num]=list(flist); save(); out({'number':int(num)}); sys.exit(0)
if base=='issues':
    lab=re.search(r'labels=([^&]+)',path); 
    from urllib.parse import unquote
    lab=unquote(lab.group(1)) if lab else None
    stm=re.search(r'state=([a-z]+)',path); want=stm.group(1) if stm else 'open'
    meta=st.get('issues_meta',{})
    # fail_open_list：ラベルで絞らない「開いている物の一覧」だけ読めない（502。写し＝use_open_snapshot が作れないときのテスト用）
    if lab is None and want=='open' and st.get('fail_open_list'): sys.stderr.write('HTTP 502\n'); sys.exit(1)
    # 本物の一覧と同じく、本文（body）も返す（写しから本文を読むため）
    res=[{'number':int(n),'title':meta.get(n,{}).get('title','t'),'state':meta.get(n,{}).get('state','open'),'body':meta.get(n,{}).get('body',''),'updated_at':st['issue_updated'].get(n,now),'user':{'login':st.get('authors',{}).get(n,'o')},'labels':[{'name':x} for x in L],'closed_at':meta.get(n,{}).get('closed_at'),'state_reason':meta.get(n,{}).get('state_reason'),**({'pull_request':{}} if any(str(p.get('number'))==n for p in st.get('pulls',[])) else {})} for n,L in st['labels'].items() if (lab is None or lab in L) and (want=='all' or meta.get(n,{}).get('state','open')==want)]
    paged(res); sys.exit(0)
m=re.match(r'pulls/(\d+)/comments$',base)
if m:
    rc=st.get('review_comments',[])
    paged(rc); sys.exit(0)
m=re.match(r'apps/([^/]+)$',base)
if m:
    _a=st.get('apps',{}).get(m.group(1))
    if _a is None: sys.stderr.write('HTTP 404: Not Found\n'); sys.exit(1)
    out({'id':_a,'slug':m.group(1)}); sys.exit(0)
m=re.match(r'pulls/(\d+)/reviews$',base)
if m and method=='GET':
    paged(st.get('reviews',{}).get(m.group(1),[])); sys.exit(0)
m=re.match(r'pulls/(\d+)/commits$',base)
if m:
    pc=st.get('pr_commits',{}).get(m.group(1),[])
    paged(pc); sys.exit(0)
m=re.match(r'pulls/(\d+)/files$',base)
# 文字列は普通の（文字の差分がある）ファイル。dict はそのまま（画像など patch の無いファイルを表すのに使う）
if m: paged([f if isinstance(f,dict) else {'filename':f,'patch':'@@ -1 +1 @@','changes':1} for f in st.get('files',[])]); sys.exit(0)
m=re.match(r'contents/(.+)$',base)
if m and method=='GET':
    from urllib.parse import unquote
    ref=re.search(r'ref=([^&]+)',path); ref=ref.group(1) if ref else 'main'
    # contents_sha：{ref:{パス:sha}}。あれば、本物と同じく sha を含む JSON を返す（ファイルの中身の代わり）
    _sha=st.get('contents_sha',{}).get(ref,{}).get(unquote(m.group(1)))
    if _sha is not None: out({'sha':_sha}); sys.exit(0)
    body=st.get('contents',{}).get(ref,{}).get(unquote(m.group(1)))
    if body is None: sys.stderr.write('HTTP 404: Not Found\n'); sys.exit(1)
    sys.stdout.write(body); sys.exit(0)
m=re.match(r'pulls/(\d+)/merge$',base)
# merge_fail があれば、マージを断る（main との衝突などを表す）
# merge_fail_times：その回数だけ、一時的なエラー（502）を返してから通す
if m and method=='PUT' and st.get('merge_fail_times',0)>0:
    st['merge_fail_times']-=1; save(); sys.stderr.write('gh: Server Error (HTTP 502)\n'); sys.exit(1)
if m and method=='PUT' and st.get('merge_fail'): sys.stderr.write(st['merge_fail']+'\n'); sys.exit(1)
if m and method=='PUT': st.setdefault('merged',[]).append(int(m.group(1))); save(); print('{}'); sys.exit(0)
m=re.match(r'pulls/(\d+)$',base)
if m:
    for pr in st['pulls']:
        if pr['number']==int(m.group(1)):
            if method=='PATCH':
                if 'body' in fields: pr['body']=fields['body']
                save(); print('{}'); sys.exit(0)
            out(pr); sys.exit(0)
m=re.match(r'commits/([^/]+)/check-runs$',base)
# checks_later・checks_flip_after：この回数だけ読まれたあとは、checks_later を返す（待っている間にチェックが終わった、を表す）
if m:
    st['checks_calls']=st.get('checks_calls',0)+1; save()
    if 'checks_later' in st and st['checks_calls']>st.get('checks_flip_after',0): out({'check_runs':st['checks_later']}); sys.exit(0)
    out({'check_runs':st.get('checks',[])}); sys.exit(0)
# コミットステータスを付ける（POST statuses/<sha>）：status_posts に記録する。status_fail があれば断る（権限が無い、を表す）
m=re.match(r'statuses/([^/]+)$',base)
if m and method=='POST':
    if st.get('status_fail'): sys.stderr.write('HTTP 403: Resource not accessible by integration\n'); sys.exit(1)
    st.setdefault('status_posts',[]).append({'sha':m.group(1),'state':fields.get('state'),'context':fields.get('context'),'description':fields.get('description'),'token':os.environ.get('GH_TOKEN','')}); save(); print('{}'); sys.exit(0)
# コミットステータス（まとめ）：st['statuses'] = [{'context':'Vercel','state':'failure','description':'…','target_url':'…'}]
m=re.match(r'commits/([^/]+)/status$',base)
if m:
    ss=st.get('statuses_by_sha',{}).get(m.group(1), st.get('statuses',[]))
    out({'state':'pending' if not ss or any(x['state']=='pending' for x in ss) else ('failure' if any(x['state']!='success' for x in ss) else 'success'),'statuses':ss}); sys.exit(0)
if re.match(r'actions/runs/\d+/jobs$',base): out({'jobs':st.get('jobs',[])}); sys.exit(0)
# ジョブのログ（job_logs: {ジョブの番号: 文字列}）。無ければ断る（読めない、を表す）
m=re.match(r'actions/jobs/(\d+)/logs$',base)
if m:
    _l=st.get('job_logs',{}).get(m.group(1))
    if _l is None: sys.stderr.write('HTTP 403: Resource not accessible by integration\n'); sys.exit(1)
    sys.stdout.write(_l); sys.exit(0)
# 実行の取り消し（レビューAIを CI と同時に動かしたとき、CIが落ちたら取り消す）
m=re.match(r'actions/runs/(\d+)/cancel$',base)
if m and method=='POST':
    st.setdefault('cancels',[]).append(int(m.group(1))); save(); print('{}'); sys.exit(0)
m=re.match(r'actions/runs/(\d+)/rerun-failed-jobs$',base)
if m and method=='POST':
    if st.get('rerun_fail'): sys.stderr.write('HTTP 403: Resource not accessible by integration\n'); sys.exit(1)
    st.setdefault('reruns',[]).append(int(m.group(1))); st.setdefault('rerun_tokens',[]).append(os.environ.get('GH_TOKEN','')); save(); print('{}'); sys.exit(0)
# 空コミットの作成とブランチの更新（見張り役が、CIの承認待ちを動かし直すとき）。記録だけする
m=re.match(r'git/commits/([^/]+)$',base)
if m and method=='GET': out({'tree':{'sha':'tree-'+m.group(1)},'sha':m.group(1)}); sys.exit(0)
if base=='git/commits' and method=='POST':
    st.setdefault('new_commits',[]).append(fields.get('message',''))
    if inbody is not None: st.setdefault('new_commit_bodies',[]).append(inbody)
    save(); out({'sha':'newcommit'}); sys.exit(0)
# 木を作る（基準の画像だけのコンフリクトを API で解くとき）：送った中身を new_trees に残す
if base=='git/trees' and method=='POST':
    st.setdefault('new_trees',[]).append(inbody); save(); out({'sha':'newtree'}); sys.exit(0)
# 木を読む：st['trees'] = {sha: {'tree':[{'path':…,'mode':'100644','type':'blob','sha':…}],'truncated':False}}
m=re.match(r'git/trees/([^/]+)$',base)
if m and method=='GET': out(st.get('trees',{}).get(m.group(1),{'tree':[],'truncated':False})); sys.exit(0)
# ブランチの先頭（git/ref/heads/main）：st['ref_shas'] = {'main':'…'}（無ければ 'mainsha'）
m=re.match(r'git/ref/heads/(.+)$',base)
if m and method=='GET': out({'object':{'sha':st.get('ref_shas',{}).get(m.group(1),'mainsha')}}); sys.exit(0)
m=re.match(r'git/refs/heads/(.+)$',base)
# ref_update_fail：ブランチを動かせない（その間に別の push が入った＝早送りにならない、を表す）
if m and method=='PATCH' and st.get('ref_update_fail'): sys.stderr.write('HTTP 422: Update is not a fast forward\n'); sys.exit(1)
if m and method=='PATCH':
    st.setdefault('ref_updates',[]).append(m.group(1))
    if inbody is not None: st.setdefault('ref_update_bodies',[]).append(inbody)
    save(); print('{}'); sys.exit(0)
# 実行をまるごと動かし直す。rerun_fail があれば断る
m=re.match(r'actions/runs/(\d+)/rerun$',base)
if m and method=='POST':
    if st.get('rerun_fail'): sys.stderr.write('HTTP 403: Resource not accessible by integration\n'); sys.exit(1)
    st.setdefault('reruns_all',[]).append(int(m.group(1))); save(); print('{}'); sys.exit(0)
m=re.match(r'actions/workflows/([^/]+)/runs$',base)
# wf_runs_fail：このワークフローの実行の一覧は読めない（502）。status= があれば、その状態の実行だけを返す（本物と同じ）
if m and m.group(1) in st.get('wf_runs_fail',[]): sys.stderr.write('HTTP 502: Bad Gateway\n'); sys.exit(1)
if m:
    _runs=st.get('wf_runs',{}).get(m.group(1),[])
    _sm=re.search(r'status=([a-z_]+)',path)
    if _sm: _runs=[r for r in _runs if r.get('status')==_sm.group(1)]
    out({'workflow_runs':_runs}); sys.exit(0)
# PR に main を取り込む（update-branch）：update_branch_fail があれば断る（コンフリクトなど）。取り込んだPRを update_branches に残す
m=re.match(r'pulls/(\d+)/update-branch$',base)
if m and method=='PUT':
    if st.get('update_branch_fail'): sys.stderr.write('HTTP 422: merge conflict between base and head\n'); sys.exit(1)
    st.setdefault('update_branches',[]).append(int(m.group(1))); save(); print('{}'); sys.exit(0)
m=re.match(r'actions/workflows/([^/]+)/dispatches$',base)
if m and method=='POST':
    st.setdefault('dispatches',[]).append({'workflow':m.group(1),**fields}); save(); sys.exit(0)
if base=='actions/runs' and st.get('runs_fail'): sys.stderr.write('HTTP 502: Bad Gateway\n'); sys.exit(1)
if base=='actions/runs':
    _runs=list(st.get('runs',[]))
    # CI の実行（name == "CI"）が runs に無ければ、check run のうち GitHub Actions の物から1つの CI の実行を作る
    # （古いテストは check run だけで CI の状態を表している）。ci_runs_none があれば作らない（実行が見つからない、を表す）
    if 'head_sha=' in path and not st.get('ci_runs_none') and not any(r.get('name')=='CI' for r in _runs):
        _ac=[c for c in st.get('checks',[]) if (c.get('app') or {}).get('slug')=='github-actions']
        if _ac:
            _done=all(c.get('status')=='completed' for c in _ac)
            _ok=all(c.get('conclusion') in ('success','neutral','skipped') for c in _ac)
            _runs.append({'id':9000,'name':'CI','event':'pull_request','created_at':'2026-01-01T00:00:00Z','status':'completed' if _done else 'in_progress','conclusion':('success' if _ok else 'failure') if _done else None})
    out({'workflow_runs':_runs}); sys.exit(0)
# 比べる（compare/A...B）：st['compare'] = {'main...abc': {'files':[…]}} があれば、それも返す（基準の画像だけのコンフリクトの見分け）
if base.startswith('compare/'): out({'ahead_by':st.get('ahead_by',0),**st.get('compare',{}).get(base[len('compare/'):],{})}); sys.exit(0)
m=re.match(r'commits/([^/]+)$',base)
if m and m.group(1) in st.get('commit_fail',[]): sys.stderr.write('HTTP 502\n'); sys.exit(1)
if m: st['commit_calls']=st.get('commit_calls',0)+1; save()
if m: out({'commit':{'committer':{'date':'2026-01-01T00:00:00Z'}},'files':[{'filename':f} for f in st.get('commit_files',{}).get(m.group(1),[])]}); sys.exit(0)
if base=='pulls' and method=='POST':
    # PR を作る：head を created_pulls に残す
    st.setdefault('created_pulls',[]).append({'head':fields.get('head'),'title':fields.get('title')}); save()
    out({'html_url':'https://github.com/o/r/pull/%d'%(100+len(st['created_pulls'])),'number':100+len(st['created_pulls'])}); sys.exit(0)
# uncreated_pulls：この番号のPRは、PRを作る（POST pulls）まで一覧に出ない（open-pr.sh が「PRはもうあります」と読まないように）
if base=='pulls':
    # state= が付いていれば絞る（PR に 'state':'closed' を書いた物だけが閉じたPR。書かなければ open。state=all や無指定は全部）
    _ps=re.search(r'[?&]state=([a-z]+)',path); _ps=_ps.group(1) if _ps else 'all'
    _sel=lambda p: _ps not in('open','closed') or (p.get('state','open')==_ps)
    paged([p for p in st.get('pulls',[]) if _sel(p) and (st.get('created_pulls') or p['number'] not in st.get('uncreated_pulls',[]))]); sys.exit(0)
# branches_list_fail：ブランチの一覧は読めない（502。「ブランチが無い」と取り違えないかのテスト用）
if base=='branches' and st.get('branches_list_fail'): sys.stderr.write('HTTP 502\n'); sys.exit(1)
if base=='branches':
    # ghost_branches：一覧には出るが、1つずつ読むと見つからない（一覧のあとに消えた）ブランチ
    paged([{'name':b['name']} for b in st.get('branches',[])] + [{'name':g} for g in st.get('ghost_branches',[])]); sys.exit(0)
m=re.match(r'branches/(.+)$',base)
if m:
    for b in st.get('branches',[]):
        if b['name']==m.group(1): out({'commit':{'commit':{'committer':{'date':b['date']}}}}); sys.exit(0)
    sys.stderr.write('branch not found\n'); sys.exit(1)
m=re.match(r'git/refs/heads/(.+)$',base)
if m and method=='DELETE':
    st['branches']=[b for b in st.get('branches',[]) if b['name']!=m.group(1)]; save(); sys.exit(0)
sys.stderr.write('UNHANDLED %s %s\n'%(method,path)); sys.exit(1)
